            const prevBtn = document.getElementById('prev-frame-btn');\
            \
            if(nextBtn) nextBtn.classList.toggle('hidden', currentFrame === totalFrames);\
            if(finishBtn) finishBtn.classList.toggle('hidden', currentFrame !== totalFrames);\
            if(prevBtn) \{\
                if(currentFrame === 1) \{ prevBtn.classList.add('opacity-50', 'cursor-not-allowed'); \} \
